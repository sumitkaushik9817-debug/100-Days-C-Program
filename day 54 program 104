#include <stdio.h>

int main() {
    int n, x;
    int leftSum, rightSum;

    printf("Enter n: ");
    scanf("%d", &n);

    for (x = 1; x <= n; x++) {
        leftSum = 0;
        rightSum = 0;

        // Sum from 1 to x
        for (int i = 1; i <= x; i++) {
            leftSum += i;
        }

        // Sum from x to n
        for (int i = x; i <= n; i++) {
            rightSum += i;
        }

        if (leftSum == rightSum) {
            printf("%d\n", x);
            return 0;
        }
    }

    printf("-1\n");

    return 0;
}
