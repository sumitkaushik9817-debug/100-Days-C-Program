#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100];
    int count[26] = {0};
    int flag = 1;

    scanf("%99s", str1);
    scanf("%99s", str2);

    if(strlen(str1) != strlen(str2)) {
        flag = 0;
    }
    else {
        for(int i = 0; str1[i] != '\0'; i++) {
            count[str1[i] - 'a']++;
            count[str2[i] - 'a']--;
        }

        for(int i = 0; i < 26; i++) {
            if(count[i] != 0) {
                flag = 0;
                break;
            }
        }
    }

    if(flag == 1)
        printf("Anagram");
    else
        printf("Not Anagram");

    return 0;
}
