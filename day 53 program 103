#include <stdio.h>

int main() {
    int n, arr[100];
    int leftSum, rightSum;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < n; i++) {
        leftSum = 0;
        rightSum = 0;

        // Calculate left sum
        for (int j = 0; j < i; j++) {
            leftSum += arr[j];
        }

        // Calculate right sum
        for (int j = i + 1; j < n; j++) {
            rightSum += arr[j];
        }

        if (leftSum == rightSum) {
            printf("%d\n", i);
            return 0;
        }
    }

    printf("-1\n");

    return 0;
}
